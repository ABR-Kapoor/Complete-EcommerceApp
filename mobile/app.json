{
  "expo": {
    "name": "AuraMart",
    "slug": "auramart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "auramart",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/AuraMart-transparent-Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#F9FDFE"
      },
      "package": "com.aurasutra.auramart"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "image": "./assets/AuraMart-transparent-Logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AuraMart to use your microphone for voice product search.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
